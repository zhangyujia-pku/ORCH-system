+
+
+def test_delete_returns_bool():
+    t = storage.create("x")
+    assert storage.delete(t["id"]) is True
+    assert storage.delete(999) is False
+
+
+def test_rm_existing(capsys):
+    t = storage.create("x")
+    assert main(["rm", str(t["id"])]) == 0
+    assert capsys.readouterr().out.strip() == "已删除"
+
+
+def test_rm_missing(capsys):
+    assert main(["rm", "999"]) == 0
+    assert capsys.readouterr().out.strip() == "不存在"
