diff --git a/tests/test_cli.py b/tests/test_cli.py
index a586933..298a9b3 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -6,6 +6,35 @@ def setup_function():
     storage.reset()
 
 
+def test_delete_returns_bool():
+    task = storage.create("x")
+    assert storage.delete(task["id"]) is True
+    assert storage.delete(task["id"]) is False
+    assert storage.delete(999) is False
+
+
+def test_rm_existing_task(capsys):
+    task = storage.create("x")
+    assert main(["rm", str(task["id"])]) == 0
+    assert capsys.readouterr().out == "已删除\n"
+    assert storage.get(task["id"]) is None
+
+
+def test_rm_missing_task(capsys):
+    assert main(["rm", "999"]) == 0
+    assert capsys.readouterr().out == "不存在\n"
+
+
+def test_rm_missing_id(capsys):
+    assert main(["rm"]) == 2
+    assert capsys.readouterr().out == "缺少 id\n"
+
+
+def test_rm_invalid_id(capsys):
+    assert main(["rm", "invalid"]) == 2
+    assert capsys.readouterr().out == "无效 id\n"
+
+
 def test_add_then_list(capsys):
