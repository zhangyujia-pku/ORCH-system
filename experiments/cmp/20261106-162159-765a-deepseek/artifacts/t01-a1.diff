+def test_storage_persists_tasks_after_restart(tmp_path, monkeypatch):
+    monkeypatch.setattr(storage, "DATA_FILE", tmp_path / "tasks.json")
+    storage.reset()
+    saved = storage.create("持久化任务")
+
+    storage.TASKS = {task["id"]: task for task in storage._load()}
+    storage._next_id = max(storage.TASKS, default=0) + 1
+
+    assert storage.list_all() == [saved]
+    assert storage.get(saved["id"]) == saved
